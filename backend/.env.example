# Backend runtime environment variables (set as Lambda env vars / SAM params).
# These are configured via the SAM template parameters, not a .env file in Lambda.
# Listed here for local reference and local testing (sam local invoke).

# Bedrock model to use for command generation.
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Allowed CORS origin. Use your Amplify domain in production, e.g.
# https://main.xxxxxxxx.amplifyapp.com
CORS_ORIGIN=*

# Region (Lambda provides AWS_REGION automatically at runtime).
AWS_REGION=us-east-1
